{
  "name": "project-management-backend",
  "version": "1.0.0",
  "description": "High-Value Project Management Backbone - Backend API",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@nodewave/prisma-ezfilter": "^0.2.1",
    "@prisma/client": "^5.12.1",
    "bcryptjs": "^2.4.3",
    "hono": "^4.2.4",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "prisma": "^5.12.1",
    "typescript": "^5.4.5"
  }
}
